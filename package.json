{
  "name": "shift3d",
  "private": true,
  "version": "1.0.1",
  "description": "Shift ideas into 3D. AI text/image to textured, game-ready 3D models.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
