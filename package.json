{
  "name": "model-ai",
  "productName": "Model AI",
  "version": "1.0.0",
  "description": "Paste in a picture, get a 3D model.",
  "author": "vcecho100-dot",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "three": "0.159.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.vcecho100.modelai",
    "files": ["main.js", "index.html", "icon.svg", "build/icon.png", "node_modules/three/build/three.min.js"],
    "win": { "icon": "build/icon.png" },
    "portable": { "artifactName": "ModelAI.exe" },
    "directories": { "output": "dist" }
  }
}
