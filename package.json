    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "draco3dgltf": "^1.5.9",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.60.0",
    "mediabunny": "^1.62.0",
    "meshoptimizer": "^1.3.0",
